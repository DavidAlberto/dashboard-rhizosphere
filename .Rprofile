# Description: This file is used to set up the R environment when R starts up.
print("Rprofile loaded")

# Set CRAN repository for package installations  
options(repos = c(CRAN = "https://cran.rstudio.com/"))  

# Activate the renv environment for package management  
source("renv/activate.R")  

# Ensure Firefox is set as the default browser  
options(browser = "firefox")
Sys.setenv(R_BROWSER = "firefox")